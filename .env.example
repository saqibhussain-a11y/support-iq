# --- App ---
APP_ENV=development

# --- Host ports (docker-compose) ---
# Override any of these if the default port is already taken on your machine.
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# --- Postgres (used by docker-compose to create the DB container) ---
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq

# --- Backend (FastAPI) ---
# When running the backend outside docker-compose, point this at localhost instead of the "postgres" hostname.
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@localhost:5432/supportiq

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
