# --- App ---
APP_ENV=development

# --- Postgres (the only thing that runs in Docker — see docker-compose.yml) ---
# POSTGRES_PORT=5432   # override if 5432 is already taken on your machine
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq

# --- Backend (FastAPI, runs natively — see README for the run command) ---
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@localhost:5432/supportiq

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (local, via fastembed — no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# KNOWLEDGE_BASE_PATH=/absolute/path/to/knowledge_base

# --- Retrieval / reranking (local, via fastembed — no API key needed) ---
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_TOP_K=5
RRF_K=60

# --- Observability: LangSmith (optional — leave LANGSMITH_TRACING=false to skip) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportiq

# --- Observability: OpenTelemetry console span dump (noisy — off by default) ---
# Set to true to see every span printed as JSON in the backend's own terminal.
# scripts/demo_tracing.py shows a readable trace tree without needing this.
OTEL_CONSOLE_EXPORT=false

# --- Observability: OpenTelemetry export to Jaeger (start it with: docker compose up -d jaeger) ---
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export. Jaeger UI: http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_QUERY_URL=http://localhost:16686
# JAEGER_UI_PORT=16686        # override docker-compose host ports if taken
# JAEGER_OTLP_HTTP_PORT=4318
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
