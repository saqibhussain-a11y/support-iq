# --- App ---
APP_ENV=development

# --- Postgres (used by docker-compose to create the DB container) ---
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq

# --- Backend (FastAPI) ---
# When running the backend outside docker-compose, point this at localhost instead of the "postgres" hostname.
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@localhost:5432/supportiq

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (reserved for Module 2 — not used yet) ---
GROQ_API_KEY=
GROQ_MODEL=
